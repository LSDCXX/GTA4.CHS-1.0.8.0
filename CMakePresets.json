{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x86-base",
      "description": "面向具有 Visual Studio 开发环境的 Windows。",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_MAKE_PROGRAM": "Q:/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_PREFIX_PATH": "${sourceDir}/out/local-deps",
        "ZLIB_ROOT": "${sourceDir}/out/local-deps",
        "ZLIB_INCLUDE_DIR": "${sourceDir}/out/local-deps/include",
        "ZLIB_LIBRARY": "${sourceDir}/out/local-deps/lib/zlibstatic.lib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x86-debug",
      "displayName": "x86 Debug",
      "configurePreset": "windows-x86-base",
      "configuration": "Debug"
    },
    {
      "name": "x86-release",
      "displayName": "x86 Release",
      "configurePreset": "windows-x86-base",
      "configuration": "Release"
    }
  ]
}
